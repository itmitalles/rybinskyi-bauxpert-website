---
import { siteConfig } from "@/config/site";
import Icon from "./Icon.astro";
---

<div class="inquiry-builder" data-inquiry-builder>
  <form id="inquiry-form">
    <div class="form-grid">
      <label>Name <input name="name" autocomplete="name" placeholder="Ihr Name" /></label>
      <label>Art des Projekts
        <select name="project">
          <option value="">Bitte wählen</option>
          <option>Renovierung</option><option>Sanierung</option><option>Trockenbau</option>
          <option>Malerarbeiten</option><option>Fliesenarbeiten</option><option>Bodenverlegung</option>
          <option>Montage</option><option>Rückbau</option><option>Sonstiges</option>
        </select>
      </label>
      <label>Ort / Stadtteil <input name="location" autocomplete="address-level2" placeholder="z. B. Giesing" /></label>
      <label>Ungefährer Umfang <input name="scope" placeholder="z. B. 3 Zimmer, ca. 70 m²" /></label>
      <label>Gewünschter Zeitraum <input name="period" placeholder="z. B. ab Oktober" /></label>
    </div>
    <label>Beschreibung <textarea name="description" rows="6" placeholder="Was soll gemacht werden? Wie ist der aktuelle Zustand?"></textarea></label>
    <p class="form-hint">Ihre Angaben werden nicht an diese Website übertragen. Erst mit dem nächsten Klick öffnen Sie WhatsApp oder Ihr E-Mail-Programm.</p>
    <div class="builder-actions">
      <a class="button button-whatsapp" data-whatsapp href="#" target="_blank" rel="noreferrer"><Icon name="whatsapp" size={19} /> Per WhatsApp senden</a>
      <a class="button button-secondary" data-email href="#"><Icon name="mail" size={19} /> Per E-Mail senden</a>
    </div>
  </form>
</div>

<script is:inline define:vars={{ phone: siteConfig.whatsappNumber, email: siteConfig.email }}>
  const builder = document.querySelector("[data-inquiry-builder]");
  const form = builder?.querySelector("form");
  const whatsapp = builder?.querySelector("[data-whatsapp]");
  const emailLink = builder?.querySelector("[data-email]");
  const labelMap = { name: "Name", project: "Projekt", location: "Ort / Stadtteil", scope: "Umfang", period: "Zeitraum", description: "Beschreibung" };

  const updateLinks = () => {
    if (!form || !whatsapp || !emailLink) return;
    const values = Object.fromEntries(new FormData(form).entries());
    const lines = ["Hallo Rybinskyi BauXpert,", "", "ich möchte folgendes Projekt besprechen:"];
    for (const [key, label] of Object.entries(labelMap)) {
      const value = String(values[key] ?? "").trim();
      if (value) lines.push(`${label}: ${value}`);
    }
    lines.push("", "Viele Grüße");
    const message = lines.join("\n");
    whatsapp.href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
    emailLink.href = `mailto:${email}?subject=${encodeURIComponent(`Projektanfrage${values.project ? `: ${values.project}` : ""}`)}&body=${encodeURIComponent(message)}`;
  };
  form?.addEventListener("input", updateLinks);
  updateLinks();
</script>

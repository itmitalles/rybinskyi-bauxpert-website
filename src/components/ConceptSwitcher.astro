---
import { siteConfig } from "@/config/site";
---

{siteConfig.previewMode && <button class="concept-switcher" type="button" data-change-concept lang="uk" aria-label="Designvariante wechseln">Варіанти</button>}

<script is:inline>
  document.querySelector("[data-change-concept]")?.addEventListener("click", () => {
    sessionStorage.removeItem("rybinskyi-preview-concept");
    location.reload();
  });
</script>

<style>
  .concept-switcher { position: fixed; z-index: 70; left: 1rem; bottom: 1rem; border: 1px solid rgba(255,255,255,.3); border-radius: 2px; padding: .45rem .7rem; color: white; background: rgba(23,25,22,.92); box-shadow: 0 8px 30px rgba(0,0,0,.2); font-size: .68rem; font-weight: 800; letter-spacing: .06em; cursor: pointer; }
  .concept-switcher:hover { background: #9f3f27; }
  @media(max-width:700px){ .concept-switcher { bottom: 72px; } }
</style>

---
import logo from "@/assets/brand/logo.png";
import { Image } from "astro:assets";
import { siteConfig } from "@/config/site";
import { withBase } from "@/lib/urls";

if (!/^[a-f0-9]{64}$/i.test(siteConfig.previewPinHash)) {
  throw new Error("Preview PIN hash must be a SHA-256 hex digest.");
}
---

{siteConfig.previewMode && (
  <div class="pin-gate" data-pin-gate data-pin-hash={siteConfig.previewPinHash} role="dialog" aria-modal="true" aria-labelledby="pin-title">
    <div class="pin-panel" data-pin-panel>
      <Image src={logo} alt="Rybinskyi BauXpert" width={140} height={140} loading="eager" />
      <p class="eyebrow">Kundenansicht</p>
      <h1 id="pin-title">Website Preview</h1>
      <p>Bitte PIN eingeben, um den aktuellen Entwurf anzusehen.</p>
      <form data-pin-form>
        <label for="preview-pin">Preview-PIN</label>
        <div class="pin-input-row">
          <input id="preview-pin" name="pin" type="password" inputmode="numeric" autocomplete="one-time-code" maxlength="12" required autofocus />
          <button class="button button-primary" type="submit">Öffnen</button>
        </div>
        <p class="pin-error" data-pin-error role="alert" hidden>Der PIN ist nicht richtig.</p>
      </form>
      <small>Hinweis: Dieser Schutz hält zufällige Besucher fern, ist aber keine sichere Zugangskontrolle.</small>
    </div>
    <div class="concept-panel" data-concept-panel hidden lang="uk">
      <p class="concept-kicker">Презентація для клієнта</p>
      <h1>Оберіть варіант дизайну</h1>
      <p class="concept-intro">Обидва варіанти швидші, зручніші на телефоні та показують реальні роботи замість неперевірених рекламних обіцянок.</p>
      <div class="concept-benefits" aria-label="Переваги порівняно зі старим сайтом">
        <span>Реальні проєкти</span><span>Прямий контакт</span><span>Локальний пошук</span><span>Без трекінгу</span>
      </div>
      <div class="concept-grid">
        <article>
          <p class="concept-number">Варіант A</p>
          <h2>Майстерня</h2>
          <p>Теплий, прямий і приземлений стиль. У центрі — процес роботи, широкий спектр послуг і справжні фотографії.</p>
          <strong>Перевага:</strong><p>Багато локальної довіри та дуже зрозумілий шлях до контакту.</p>
          <a class="concept-link" href={withBase("/")} data-concept-link="workshop">Відкрити варіант A</a>
        </article>
        <article class="concept-featured">
          <p class="concept-number">Варіант B</p>
          <h2>Преміум</h2>
          <p>Стриманіший і дорожчий візуальний стиль. У центрі — сауна, ванна кімната, паркет і якість деталей.</p>
          <strong>Перевага:</strong><p>Краще звертається до клієнтів з вищими вимогами — без штучного гламуру.</p>
          <a class="concept-link" href={withBase("/premium/")} data-concept-link="premium">Відкрити варіант B</a>
        </article>
      </div>
      <small>Стара сторінка не змінюється. Це два окремі нові напрями для порівняння.</small>
    </div>
  </div>
)}

<script is:inline>
  (() => {
    const gate = document.querySelector("[data-pin-gate]");
    if (!gate) return;
    const sessionKey = "rybinskyi-preview-access";
    const conceptKey = "rybinskyi-preview-concept";
    const pinPanel = gate.querySelector("[data-pin-panel]");
    const conceptPanel = gate.querySelector("[data-concept-panel]");
    const showConcepts = () => {
      pinPanel.hidden = true;
      conceptPanel.hidden = false;
      document.documentElement.classList.add("preview-locked");
    };
    if (sessionStorage.getItem(sessionKey) === "granted" && sessionStorage.getItem(conceptKey)) {
      gate.remove();
      document.documentElement.classList.remove("preview-locked");
      return;
    }
    if (sessionStorage.getItem(sessionKey) === "granted") showConcepts();
    document.documentElement.classList.add("preview-locked");
    const form = gate.querySelector("[data-pin-form]");
    const input = gate.querySelector("input");
    const error = gate.querySelector("[data-pin-error]");
    const encodeHex = (bytes) => Array.from(bytes).map((byte) => byte.toString(16).padStart(2, "0")).join("");
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(input.value));
      if (encodeHex(new Uint8Array(digest)) === gate.dataset.pinHash) {
        sessionStorage.setItem(sessionKey, "granted");
        showConcepts();
        return;
      }
      error.hidden = false;
      input.value = "";
      input.focus();
      gate.querySelector(".pin-panel")?.classList.add("pin-invalid");
      window.setTimeout(() => gate.querySelector(".pin-panel")?.classList.remove("pin-invalid"), 250);
    });
    gate.querySelectorAll("[data-concept-link]").forEach((link) => link.addEventListener("click", () => {
      sessionStorage.setItem(conceptKey, link.dataset.conceptLink);
    }));
  })();
</script>

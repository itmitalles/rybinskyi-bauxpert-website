---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContactBand from "@/components/ContactBand.astro";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/urls";
---

<BaseLayout title="Über mich | Denys Rybinskyi | BauXpert München" description="Denys Rybinskyi: von der selbst aufgebauten Baufirma in der Ukraine zum persönlichen Handwerksbetrieb Rybinskyi BauXpert in München.">
  <div class="page-hero" data-approved-biography><div class="shell"><p class="eyebrow">Über mich</p><h1>Hallo, ich bin Denys Rybinskyi.</h1><p class="lead">Ich komme aus der Ukraine. Dort habe ich mir eine Baufirma mit mehreren Mitarbeitern aufgebaut. Wegen der Lage im Donbass musste ich den Betrieb leider aufgeben. In München baue ich mir nun ein neues Leben und einen neuen Handwerksbetrieb auf.</p></div></div>
  <Breadcrumbs items={[{label:"Über mich"}]} />

  <section class="section about-section">
    <div class="shell about-grid">
      <div class="identity-field" aria-label="Rybinskyi BauXpert"><img src={withBase("/brand/rybinskyi-bauxpert-logo.webp")} alt="Rybinskyi BauXpert" width="320" height="320" loading="eager" /></div>
      <div>
        <p class="eyebrow">Der Betrieb</p>
        <h2>Erfahrung mitgebracht. Noch einmal selbst aufgebaut.</h2>
        <p>In München baue ich mir nun ein neues Leben und einen neuen Handwerksbetrieb auf. Die Erfahrung aus meiner früheren Firma bringe ich heute persönlich in jedes Projekt ein.</p>
        <p>Im Mittelpunkt stehen Küchenmontage, Möbelmontage und Maßanpassung, Innenausbau, Böden sowie Renovierungsarbeiten in München und Umgebung.</p>
        <dl>
          <div><dt>Anbieter</dt><dd>{siteConfig.name}</dd></div>
          <div><dt>Kontaktperson</dt><dd>{siteConfig.owner}</dd></div>
          <div><dt>Ort</dt><dd>{siteConfig.address.postalCode} München</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section principles"><div class="shell"><p class="eyebrow">Grundsätze der Preview</p><h2>Nur zeigen, was geklärt ist.</h2><div><article><span>01</span><h3>Konkrete Leistungen</h3><p>Der tatsächliche Leistungsumfang muss vor dem Livegang von Denys bestätigt werden.</p></article><article><span>02</span><h3>Geklärte Bildrechte</h3><p>Die eingesetzten Preview-Bilder sind dokumentiert; die finale Bildfreigabe bleibt vor dem Livegang erforderlich.</p></article><article><span>03</span><h3>Klare Fachgrenzen</h3><p>Elektro- und Sanitärfacharbeiten werden nicht pauschal als Eigenleistung beworben.</p></article></div></div></section>
  <ContactBand title="Projekt konkret beschreiben." />
</BaseLayout>

<style>
  .about-grid { display:grid; grid-template-columns:minmax(320px,.7fr) minmax(0,1.3fr); align-items:center; gap:clamp(3rem,8vw,8rem); }
  .identity-field { display:grid; min-height:480px; place-items:center; align-content:center; gap:1rem; color:white; background:#171b18; }
  .identity-field img { width:min(260px,72%); height:auto; }
  .about-grid h2 + p { margin-top:1.4rem; }
  .about-grid p { color:var(--ink-soft); }
  .about-grid p + p { margin-top:1rem; }
  dl { margin:2rem 0 0; }
  dl div { display:grid; grid-template-columns:120px 1fr; border-top:1px solid var(--line); padding:.7rem 0; }
  dt { color:var(--ink-soft); font-size:.72rem; font-weight:800; text-transform:uppercase; }
  dd { margin:0; font-weight:700; }
  .principles { color:white; background:#141816; }
  .principles .eyebrow { color:#d19a6d; }
  .principles .shell > div { display:grid; grid-template-columns:repeat(3,1fr); margin-top:3rem; border-top:1px solid rgba(255,255,255,.25); }
  .principles article { border-right:1px solid rgba(255,255,255,.25); padding:2rem; }
  .principles article:first-child { border-left:1px solid rgba(255,255,255,.25); }
  .principles span { color:#d19a6d; font-family:Georgia,serif; font-size:1.3rem; }
  .principles h3 { margin:1rem 0 .5rem; }
  .principles p { color:rgba(255,255,255,.68); }
  @media(max-width:800px){ .about-grid,.principles .shell > div { grid-template-columns:1fr; } .identity-field { min-height:360px; } .principles article,.principles article:first-child { border:0; border-top:1px solid rgba(255,255,255,.25); padding:1.5rem 0; } }
</style>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { withBase } from "@/lib/urls";

const variants = [
  {
    key: "standard",
    eyebrow: "Варіант A",
    title: "Стандарт",
    description: "Прямий, зрозумілий і орієнтований на послуги — з чіткою навігацією та монтажем кухонь у центрі уваги.",
    note: "Класичний сайт",
    action: "Відкрити варіант",
    href: "/standard/",
  },
  {
    key: "premium",
    eyebrow: "Варіант B",
    title: "Преміум",
    description: "Спокійніший, вишуканіший і більш редакційний — із сильнішою візуальною структурою преміумверсії.",
    note: "Преміальний сайт",
    action: "Відкрити варіант",
    href: "/premium/",
  },
  {
    key: "kleinanzeigen",
    eyebrow: "Додатково",
    title: "Пакет для Kleinanzeigen",
    description: "Готовий текст оголошення, оформлене титульне зображення та чотири фото робіт для завантаження.",
    note: "Текст і зображення · не опубліковано",
    action: "Відкрити пакет",
    href: "/kleinanzeigen/",
  },
] as const;
---

<BaseLayout
  title="Вибір варіанта | Rybinskyi BauXpert Preview"
  description="Захищений PIN-кодом попередній перегляд двох версій сайту та пакета Kleinanzeigen для Rybinskyi BauXpert."
  hideChrome={true}
  lang="uk"
>
  <div class="variant-overview" data-variant-overview>
    <header class="overview-header">
      <a class="overview-brand" href={withBase("/")} aria-label="Вибір варіанта Rybinskyi BauXpert">
        <img src={withBase("/brand/rybinskyi-bauxpert-logo.webp")} alt="" width="320" height="320" />
        <strong>Rybinskyi BauXpert</strong>
      </a>
      <span class="preview-status">Попередній перегляд · noindex</span>
    </header>

    <main class="overview-main" aria-labelledby="overview-title">
      <div class="overview-intro">
        <p class="overview-kicker">Одне посилання · два варіанти сайту · один пакет оголошення</p>
        <h1 id="overview-title">Усе в одному місці.</h1>
        <p>Порівняйте стандартну та преміумверсію. Пакет Kleinanzeigen окремо містить готовий текст і зображення. Велика панель угорі кожної сторінки повертає до цього вибору.</p>
      </div>

      <div class="variant-grid" aria-label="Три варіанти попереднього перегляду">
        {variants.map((variant, index) => (
          <article class:list={["variant-card", `variant-${variant.key}`]} data-variant-card={variant.key}>
            <div class="variant-number" aria-hidden="true">0{index + 1}</div>
            <div class="variant-copy">
              <p>{variant.eyebrow}</p>
              <h2>{variant.title}</h2>
              <span>{variant.note}</span>
              <p class="variant-description">{variant.description}</p>
            </div>
            <a class="variant-link" data-variant-link={variant.key} href={withBase(variant.href)}>
              {variant.action} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>

      <aside class="overview-notice" aria-label="Примітки до попереднього перегляду">
        <strong>Ще не схвалено для остаточної публікації.</strong>
        <p>Контактні дані, інформацію про виконавця, перелік послуг, права на зображення та фінальний дизайн Denys має підтвердити до публікації. Фото клієнта включені до цієї PIN-версії для спільного узгодження.</p>
      </aside>
    </main>

    <footer class="overview-footer">
      <p>{siteConfig.name} · внутрішній вибір клієнта</p>
      <nav aria-label="Юридична інформація">
        <a href={withBase("/impressum/")}>Вихідні дані</a>
        <a href={withBase("/datenschutz/")}>Захист даних</a>
      </nav>
    </footer>
  </div>
</BaseLayout>

<style>
  .variant-overview {
    min-height: 100dvh;
    color: #f7f2e8;
    background:
      radial-gradient(circle at 92% 8%, rgba(196, 128, 79, .22), transparent 27rem),
      linear-gradient(145deg, #141816 0%, #202720 55%, #131614 100%);
  }

  .overview-header,
  .overview-footer,
  .overview-main {
    width: min(100% - 40px, 1260px);
    margin-inline: auto;
  }

  .overview-header {
    display: flex;
    min-height: 88px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, .14);
  }

  .overview-brand {
    display: inline-flex;
    align-items: center;
    gap: .8rem;
    color: inherit;
    text-decoration: none;
  }

  .overview-brand img {
    width: 45px;
    height: 45px;
    object-fit: contain;
    border-radius: 50%;
    background: #171b18;
  }

  .overview-brand strong { font-size: .9rem; letter-spacing: .04em; }
  .preview-status { color: #e0b486; font-size: .7rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }

  .overview-main { padding-block: clamp(3rem, 8vw, 7rem); }
  .overview-intro { display: grid; max-width: 900px; gap: 1rem; margin-bottom: clamp(2.4rem, 5vw, 4.5rem); }
  .overview-kicker { color: #dda573; font-size: .72rem; font-weight: 850; letter-spacing: .18em; text-transform: uppercase; }
  .overview-intro h1 { max-width: 850px; color: white; font-size: clamp(3.2rem, 7vw, 7rem); line-height: .94; }
  .overview-intro > p:last-child { max-width: 700px; color: rgba(255, 255, 255, .68); font-size: clamp(1rem, 2vw, 1.25rem); }

  .variant-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; border: 1px solid rgba(255, 255, 255, .14); background: rgba(255, 255, 255, .14); }
  .variant-card { display: grid; min-height: 500px; grid-template-rows: auto 1fr auto; gap: 2rem; padding: clamp(1.5rem, 3vw, 2.5rem); background: #1b201c; }
  .variant-card:hover { background: #232a24; }
  .variant-standard { box-shadow: inset 0 5px #bd6b3f; }
  .variant-premium { box-shadow: inset 0 5px #d1a778; }
  .variant-kleinanzeigen { box-shadow: inset 0 5px #67a68a; }
  .variant-number { color: rgba(255, 255, 255, .55); font-family: Georgia, serif; font-size: 2.2rem; }
  .variant-copy > p:first-child { margin-bottom: .65rem; color: #dca779; font-size: .68rem; font-weight: 850; letter-spacing: .15em; text-transform: uppercase; }
  .variant-copy h2 { color: white; font-size: clamp(2.3rem, 4vw, 4rem); }
  .variant-copy > span { display: inline-block; margin: .9rem 0 1.4rem; border: 1px solid rgba(255, 255, 255, .2); padding: .35rem .5rem; color: rgba(255, 255, 255, .68); font-size: .65rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .variant-description { color: rgba(255, 255, 255, .64); }
  .variant-link { display: flex; min-height: 54px; align-items: center; justify-content: space-between; gap: 1rem; border-top: 1px solid rgba(255, 255, 255, .18); padding-top: 1rem; color: white; font-weight: 850; text-decoration: none; }
  .variant-link span { font-size: 1.5rem; transition: translate .18s ease; }
  .variant-link:hover span, .variant-link:focus-visible span { translate: .3rem 0; }

  .overview-notice { display: grid; grid-template-columns: minmax(180px, .35fr) 1fr; gap: 2rem; margin-top: 2.5rem; border-left: 5px solid #d09a6b; padding: 1.2rem 1.4rem; background: rgba(255, 255, 255, .07); }
  .overview-notice strong { color: white; font-size: 1.1rem; }
  .overview-notice p { color: rgba(255, 255, 255, .62); font-size: .86rem; }
  .overview-footer { display: flex; min-height: 90px; align-items: center; justify-content: space-between; gap: 1rem; border-top: 1px solid rgba(255, 255, 255, .14); color: rgba(255, 255, 255, .52); font-size: .76rem; }
  .overview-footer nav { display: flex; gap: 1rem; }
  .overview-footer a { color: inherit; }

  @media (max-width: 900px) {
    .variant-grid { grid-template-columns: 1fr; }
    .variant-card { min-height: 370px; }
  }

  @media (max-width: 600px) {
    .overview-header, .overview-footer, .overview-main { width: min(100% - 28px, 1260px); }
    .overview-header { align-items: flex-start; flex-direction: column; justify-content: center; padding-block: 1rem; }
    .overview-intro h1 { font-size: clamp(2.75rem, 15vw, 4.6rem); }
    .overview-notice { grid-template-columns: 1fr; gap: .6rem; }
    .overview-footer { align-items: flex-start; flex-direction: column; justify-content: center; padding-block: 1.2rem; }
  }
</style>

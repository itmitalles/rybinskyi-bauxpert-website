---
import { Image } from "astro:assets";
import sauna from "@/assets/projects/sauna/innenansicht.jpeg";
import saunaDetail from "@/assets/projects/sauna/leuchte-detail.jpeg";
import kitchenUFinished from "@/assets/projects/kuechenmontage-u-form/fertig.jpg";
import kitchenUProcess from "@/assets/projects/kuechenmontage-u-form/waehrend.jpg";
import kitchenOak from "@/assets/projects/kueche-holzfronten/fertig.jpg";
import kitchenL from "@/assets/projects/kuechenmontage-l-form/fertig.jpg";
import kitchenTallUnit from "@/assets/projects/kuechen-hochschrank/waehrend.jpg";
import wallConsoleProcess from "@/assets/projects/wandkonsole-spiegel/waehrend.jpg";
import ContactBand from "@/components/ContactBand.astro";
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { whatsappUrl, withBase } from "@/lib/urls";
---

<BaseLayout title="Hochwertiger Innenausbau in München | Rybinskyi BauXpert" description="Hochwertige Renovierung und Innenausbau in München – mit echten Projektfotos aus Sauna-Ausbau, Badsanierung, Parkett und Montage.">
  <div class="premium-page">
    <section class="premium-hero">
      <div class="premium-hero-media"><Image src={sauna} alt="Fertig ausgebauter Saunainnenraum aus hellem Holz" widths={[720,1100,1600]} sizes="(min-width: 900px) 58vw, 100vw" loading="eager" fetchpriority="high" /></div>
      <div class="premium-hero-copy">
        <p class="premium-kicker">Innenausbau · Renovierung · München</p>
        <h1>Hochwertige Räume entstehen im Detail.</h1>
        <p>Für Wohnungen und Häuser, bei denen Material, Ausführung und ein sauberes Ergebnis zählen. Persönlich betreut von Denys Rybinskyi.</p>
        <div class="button-row">
          <a class="premium-button" href={withBase("/kontakt/#anfrage")}>Projekt anfragen <Icon name="arrow" size={18} /></a>
          <a class="premium-button premium-button-quiet" href={whatsappUrl(siteConfig.whatsappText)} target="_blank" rel="noreferrer"><Icon name="whatsapp" size={18} /> WhatsApp</a>
        </div>
      </div>
      <div class="premium-proof" aria-label="Wichtige Informationen"><span>01</span><p>Echte Projektfotos</p><span>02</span><p>Direkter Ansprechpartner</p><span>03</span><p>München & Umgebung</p></div>
    </section>

    <section class="premium-work section">
      <div class="shell">
        <header class="premium-heading"><div><p class="premium-kicker">Ausgewählte Arbeiten</p><h2>Nicht behauptet.<br/>Tatsächlich gebaut.</h2></div><p>Die Bilder stammen aus der Referenzsammlung und der gewerblichen Kundenanzeige von Rybinskyi BauXpert. Keine Stockfotos, keine künstlichen Luxusräume.</p></header>
        <div class="premium-projects">
          <a class="premium-project premium-project-large" href={withBase("/projekte/kuechenmontage-u-form-muenchen/")}><Image src={kitchenUFinished} alt="Fertig montierte graue Küche über drei Raumseiten mit weißen Oberschränken" widths={[700,1000,1400]} sizes="(min-width:900px) 58vw, 100vw" loading="lazy"/><span><small>Küchenmontage · Aufbau und Ergebnis</small><strong>U-Küche in München</strong><em>Projekt ansehen →</em></span></a>
          <a class="premium-project" href={withBase("/projekte/kueche-holzfronten-muenchen/")}><Image src={kitchenOak} alt="Gerade Küchenzeile mit Holzdekor-Fronten, schwarzer Spüle und dunkler Arbeitsfläche" widths={[540,760,1000]} sizes="(min-width:900px) 38vw, 100vw" loading="lazy"/><span><small>Küche · München</small><strong>Holzdekor & dunkle Details</strong><em>Projekt ansehen →</em></span></a>
          <a class="premium-project" href={withBase("/projekte/kuechenmontage-l-form-muenchen/")}><Image src={kitchenL} alt="Fertig montierte L-Küche mit weißen Oberschränken und grauen Unterschränken" widths={[540,760,1000]} sizes="(min-width:900px) 38vw, 100vw" loading="lazy"/><span><small>Küche · München</small><strong>Montage in L-Form</strong><em>Projekt ansehen →</em></span></a>
        </div>
        <div class="premium-process-proof">
          <header class="premium-process-heading"><div><p class="premium-kicker">Montagezustände</p><h3>Auch der Weg ist echt.</h3></div><p>Ein Zwischenstand aus der gezeigten U-Küche und zwei Montagedetails aus getrennten Aufträgen. Keine künstlichen Vorher-Bilder, keine nachträglich erfundene Geschichte.</p></header>
          <div class="premium-process-grid">
            <figure><Image src={kitchenUProcess} alt="Teilweise aufgebaute graue Unterschränke, Beschläge und Werkzeuge in einem Küchenraum" widths={[420,620,820]} sizes="(min-width:900px) 33vw, 100vw" loading="lazy"/><figcaption><span>Küche</span> Schrankelemente während des Aufbaus</figcaption></figure>
            <figure><Image src={kitchenTallUnit} alt="Geöffneter Kühlschrank in einem noch nicht vollständig verkleideten Küchenhochschrank" widths={[420,620,820]} sizes="(min-width:900px) 33vw, 100vw" loading="lazy"/><figcaption><span>Detail</span> Hochschrank während der Montage</figcaption></figure>
            <figure><Image src={wallConsoleProcess} alt="Schwarze Wandkonsole zwischen zwei Spiegeln während der Montage im Flur" widths={[420,620,820]} sizes="(min-width:900px) 33vw, 100vw" loading="lazy"/><figcaption><span>Möbel</span> Wandkonsole und Spiegel im Montagezustand</figcaption></figure>
          </div>
        </div>
      </div>
    </section>

    <section class="premium-standard section">
      <div class="shell premium-standard-grid">
        <div><p class="premium-kicker">Der Anspruch</p><h2>Weniger Show.<br/>Mehr Substanz.</h2></div>
        <div class="premium-principles">
          <article><span>01</span><div><h3>Material sichtbar lassen</h3><p>Holz, Stein, Fliesen und Oberflächen wirken am besten, wenn Gestaltung und Verarbeitung zusammenpassen.</p></div></article>
          <article><span>02</span><div><h3>Details sauber ausführen</h3><p>Anschlüsse, Übergänge und Montage entscheiden darüber, ob ein Raum am Ende stimmig wirkt.</p></div></article>
          <article><span>03</span><div><h3>Direkt abstimmen</h3><p>Sie sprechen mit dem Menschen, der das Projekt übernimmt – nicht mit einem anonymen Vertrieb.</p></div></article>
        </div>
      </div>
    </section>

    <section class="premium-person section">
      <div class="shell premium-person-grid">
        <figure><Image src={saunaDetail} alt="Saunaleuchte und Aufgusskübel vor heller Holzverkleidung" widths={[650,900,1200]} sizes="(min-width:900px) 47vw, 100vw" loading="lazy"/><figcaption>Detail aus dem Sauna-Ausbau</figcaption></figure>
        <div><p class="premium-kicker">Persönlich</p><h2>Hallo, ich bin Denys Rybinskyi.</h2><p>Ich komme aus der Ukraine. Dort habe ich mir eine Baufirma mit mehreren Mitarbeitern aufgebaut. Wegen der Lage im Donbass musste ich den Betrieb leider aufgeben.</p><p>In München baue ich mir nun ein neues Leben und einen neuen Handwerksbetrieb auf. Die Erfahrung aus meiner früheren Firma bringe ich heute persönlich in jedes Projekt ein.</p><a class="premium-text-link" href={withBase("/ueber-mich/")}>Mehr über mich <Icon name="arrow" size={18}/></a></div>
      </div>
    </section>

    <section class="premium-services section">
      <div class="shell"><p class="premium-kicker">Leistungsschwerpunkte</p><div class="premium-service-list"><a href={withBase("/leistungen/renovierung/")}><span>01</span>Renovierung & Sanierung<Icon name="arrow" size={20}/></a><a href={withBase("/leistungen/fliesenarbeiten/")}><span>02</span>Bad & Fliesen<Icon name="arrow" size={20}/></a><a href={withBase("/leistungen/bodenverlegung/")}><span>03</span>Hochwertige Böden<Icon name="arrow" size={20}/></a><a href={withBase("/leistungen/montage/")}><span>04</span>Innenausbau & Montage<Icon name="arrow" size={20}/></a></div></div>
    </section>

    <ContactBand title="Ihr Projekt persönlich besprechen." text="Schicken Sie Fotos, eine kurze Beschreibung, Ort oder Stadtteil und den gewünschten Zeitraum für eine erste Einordnung." />
  </div>
</BaseLayout>

<style>
  .premium-page { --premium-dark:#141816; --premium-cream:#f3f0e9; --premium-bronze:#7d4a32; --premium-bronze-light:#d19a6d; --premium-line:rgba(20,24,22,.16); background:var(--premium-cream); }
  .premium-kicker { color:var(--premium-bronze); font-size:.7rem; font-weight:850; letter-spacing:.17em; text-transform:uppercase; }
  .premium-hero { position:relative; display:grid; min-height:min(830px,calc(100dvh - var(--header-height))); grid-template-columns:minmax(340px,.78fr) minmax(0,1.22fr); grid-template-rows:1fr auto; color:white; background:var(--premium-dark); }
  .premium-hero-media { grid-column:2; grid-row:1/-1; min-height:680px; overflow:hidden; }
  .premium-hero-media img { width:100%; height:100%; object-fit:cover; filter:saturate(.78) contrast(1.03); }
  .premium-hero-copy { display:flex; grid-column:1; grid-row:1; flex-direction:column; justify-content:center; padding:clamp(3rem,7vw,7.5rem) clamp(2rem,6vw,7rem); }
  .premium-hero h1 { max-width:700px; margin:.8rem 0 1.4rem; font-size:clamp(3.1rem,6vw,6.8rem); }
  .premium-hero-copy > p:not(.premium-kicker) { max-width:610px; color:rgba(255,255,255,.68); font-size:clamp(1rem,1.5vw,1.2rem); }
  .premium-hero .premium-kicker { color:var(--premium-bronze-light); }
  .premium-hero .button-row { margin-top:2rem; }
  .premium-button { display:inline-flex; min-height:50px; align-items:center; justify-content:center; gap:.55rem; border:1px solid var(--premium-bronze); padding:.75rem 1rem; color:white; background:var(--premium-bronze); font-size:.82rem; font-weight:800; text-decoration:none; }
  .premium-button-quiet { border-color:rgba(255,255,255,.35); background:transparent; }
  .premium-proof { display:grid; grid-column:1; grid-row:2; grid-template-columns:auto 1fr auto 1fr auto 1fr; align-items:center; gap:.65rem; border-top:1px solid rgba(255,255,255,.15); padding:1.3rem clamp(2rem,6vw,7rem); }
  .premium-proof span { color:var(--premium-bronze-light); font-family:Georgia,serif; }
  .premium-proof p { color:rgba(255,255,255,.6); font-size:.68rem; line-height:1.3; }
  .premium-heading { display:grid; grid-template-columns:1.3fr .7fr; align-items:end; gap:3rem; margin-bottom:3rem; }
  .premium-heading h2 { margin-top:.7rem; }
  .premium-heading > p { max-width:430px; color:var(--ink-soft); }
  .premium-projects { display:grid; grid-template-columns:1.35fr .65fr; gap:1rem; }
  .premium-project { position:relative; display:block; min-height:360px; overflow:hidden; color:white; background:var(--premium-dark); text-decoration:none; }
  .premium-project-large { grid-row:span 2; min-height:740px; }
  .premium-project img { width:100%; height:100%; object-fit:cover; transition:transform .5s ease; }
  .premium-project:hover img { transform:scale(1.025); }
  .premium-project > span { position:absolute; inset:auto 0 0; display:grid; padding:5rem 1.4rem 1.4rem; background:linear-gradient(transparent,rgba(10,12,11,.92)); }
  .premium-project small { color:rgba(255,255,255,.72); font-size:.66rem; letter-spacing:.1em; text-transform:uppercase; }
  .premium-project strong { margin:.25rem 0 .6rem; font-family:Georgia,serif; font-size:clamp(1.6rem,3vw,2.7rem); font-weight:500; }
  .premium-project em { color:#e1b68e; font-size:.72rem; font-style:normal; font-weight:800; }
  .premium-process-proof { margin-top:clamp(3.5rem,7vw,6rem); border-top:1px solid var(--premium-line); padding-top:clamp(2.5rem,5vw,4rem); }
  .premium-process-heading { display:grid; grid-template-columns:1.1fr .9fr; align-items:end; gap:3rem; margin-bottom:2rem; }
  .premium-process-heading h3 { margin-top:.55rem; font-size:clamp(2rem,4vw,3.6rem); }
  .premium-process-heading > p { max-width:500px; color:var(--ink-soft); }
  .premium-process-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; }
  .premium-process-grid figure { margin:0; background:#e6e1d8; }
  .premium-process-grid img { width:100%; aspect-ratio:3/4; object-fit:cover; }
  .premium-process-grid figcaption { display:grid; gap:.2rem; border-top:1px solid var(--premium-line); padding:.8rem; color:var(--ink-soft); font-size:.75rem; }
  .premium-process-grid figcaption span { color:var(--premium-bronze); font-size:.65rem; font-weight:850; letter-spacing:.11em; text-transform:uppercase; }
  .premium-standard { color:white; background:var(--premium-dark); }
  .premium-standard .premium-kicker { color:var(--premium-bronze-light); }
  .premium-standard-grid { display:grid; grid-template-columns:.78fr 1.22fr; gap:clamp(3rem,8vw,8rem); }
  .premium-standard h2 { margin-top:.8rem; }
  .premium-principles { border-top:1px solid rgba(255,255,255,.2); }
  .premium-principles article { display:grid; grid-template-columns:55px 1fr; gap:1rem; border-bottom:1px solid rgba(255,255,255,.2); padding:1.6rem 0; }
  .premium-principles span { color:#d1a37d; font-family:Georgia,serif; }
  .premium-principles h3 { margin-bottom:.35rem; font-size:1.5rem; }
  .premium-principles p { color:rgba(255,255,255,.62); }
  .premium-person { background:#dedbd3; }
  .premium-person-grid { display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:clamp(3rem,8vw,8rem); }
  .premium-person figure { margin:0; }
  .premium-person figure img { width:100%; height:auto; object-fit:cover; filter:saturate(.8); }
  .premium-person figcaption { border-top:1px solid var(--premium-line); padding:.7rem 0; color:var(--ink-soft); font-size:.7rem; }
  .premium-person h2 { margin:.7rem 0 1.4rem; }
  .premium-person p { color:var(--ink-soft); }
  .premium-person p + p { margin-top:1rem; }
  .premium-text-link { display:inline-flex; align-items:center; gap:.45rem; margin-top:1.5rem; color:var(--premium-bronze); font-weight:850; text-decoration:none; }
  .premium-services { background:var(--premium-cream); }
  .premium-service-list { margin-top:2rem; border-top:1px solid var(--premium-line); }
  .premium-service-list a { display:grid; grid-template-columns:65px 1fr auto; align-items:center; border-bottom:1px solid var(--premium-line); padding:1.2rem .4rem; font-family:Georgia,serif; font-size:clamp(1.4rem,3vw,2.4rem); text-decoration:none; }
  .premium-service-list span { color:var(--premium-bronze); font-size:1rem; }
  .premium-service-list a:hover { background:rgba(255,255,255,.6); }
  :global(.premium-page .contact-band) { background:#756a5b; }
  @media(max-width:900px){ .premium-hero { grid-template-columns:1fr; grid-template-rows:auto auto auto; } .premium-hero-media { grid-column:1; grid-row:1; min-height:55vw; } .premium-hero-copy { grid-column:1; grid-row:2; } .premium-proof { grid-column:1; grid-row:3; } .premium-projects,.premium-standard-grid,.premium-person-grid { grid-template-columns:1fr; } .premium-project-large { grid-row:auto; min-height:520px; } .premium-process-heading { grid-template-columns:1fr; gap:1.2rem; } }
  @media(max-width:650px){ .premium-hero-media { min-height:72vw; } .premium-hero h1 { font-size:clamp(2.8rem,13vw,4.3rem); } .premium-proof { grid-template-columns:auto 1fr; } .premium-heading { grid-template-columns:1fr; gap:1.2rem; } .premium-project,.premium-project-large { min-height:420px; } .premium-process-grid { grid-template-columns:1fr; } .premium-service-list a { grid-template-columns:40px 1fr auto; font-size:1.35rem; } }
</style>

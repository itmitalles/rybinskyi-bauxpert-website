---
import { getCollection, render } from "astro:content";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContactBand from "@/components/ContactBand.astro";
import Icon from "@/components/Icon.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/urls";

export async function getStaticPaths() {
  return (await getCollection("services")).map((service) => ({ params: { id: service.id }, props: { service } }));
}
const { service } = Astro.props;
const { Content } = await render(service);
const allProjects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const matchingProjects = allProjects.filter((project) => project.data.services.some((projectService) => projectService.toLowerCase().includes(service.data.shortTitle.toLowerCase().replace("arbeiten", "")))).slice(0, 2);
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: service.data.faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })) };
---

<BaseLayout title={service.data.seoTitle} description={service.data.description} schema={faqSchema}>
  <div class="page-hero"><div class="shell"><p class="eyebrow">Rybinskyi BauXpert</p><h1>{service.data.title}</h1><p class="lead">{service.data.intro}</p><a class="button button-primary" href={withBase("/kontakt/#anfrage")}>Projekt beschreiben <Icon name="arrow" size={18} /></a></div></div>
  <Breadcrumbs items={[{ label: "Leistungen", href: "/leistungen/" }, { label: service.data.shortTitle }]} />
  <section class="section service-detail"><div class="shell detail-grid"><div><SectionHeading eyebrow="Typische Arbeiten" title={`Worum es bei ${service.data.shortTitle} geht.`} /><ul class="work-list">{service.data.typicalWork.map((item) => <li><Icon name="check" size={19} /> {item}</li>)}</ul><div class="markdown-note"><Content /></div></div><aside><p class="eyebrow">Geeignet für</p><ul>{service.data.suitableFor.map((item) => <li>{item}</li>)}</ul></aside></div></section>
  <section class="section process-section"><div class="shell"><SectionHeading eyebrow="Ablauf" title="So wird aus der Anfrage ein klarer Auftrag." /><ol>{service.data.process.map((step, index) => <li><span>{String(index + 1).padStart(2,"0")}</span><p>{step}</p></li>)}</ol></div></section>
  {matchingProjects.length > 0 && <section class="section related-projects"><div class="shell"><SectionHeading eyebrow="Beispiele" title="Passende Arbeiten aus den Projekten." /><div class="project-grid">{matchingProjects.map((project) => <ProjectCard project={project} />)}</div></div></section>}
  <section class="section faq-section"><div class="shell faq-grid"><SectionHeading eyebrow="Häufige Fragen" title={`Fragen zu ${service.data.shortTitle} in München.`} /><div>{service.data.faqs.map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></div></section>
  <ContactBand title={`${service.data.shortTitle} konkret anfragen.`} />
</BaseLayout>

<style>
  .page-hero .button { margin-top: 1.8rem; }
  .detail-grid { display: grid; grid-template-columns: minmax(0,1.4fr) minmax(260px,.6fr); gap: clamp(3rem,8vw,8rem); }
  .work-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .6rem 1rem; list-style: none; }
  .work-list li { display: flex; gap: .5rem; align-items: flex-start; border-bottom: 1px solid var(--line); padding: .65rem 0; }
  .detail-grid aside { height: fit-content; border-top: 4px solid var(--clay); padding: 1.5rem; background: var(--white); }
  .detail-grid aside ul { list-style: none; }
  .detail-grid aside li { border-top: 1px solid var(--line); padding: .7rem 0; }
  .markdown-note { margin-top: 2rem; color: var(--ink-soft); font-size: .85rem; }
  .process-section { background: var(--paper-deep); }
  .process-section ol { display: grid; grid-template-columns: repeat(5,1fr); list-style: none; border-top: 1px solid var(--line); }
  .process-section li { border-right: 1px solid var(--line); padding: 1.5rem; }
  .process-section li:first-child { border-left: 1px solid var(--line); }
  .process-section span { color: var(--clay); font-family: Georgia,serif; font-size: 1.4rem; }
  .process-section p { margin-top: 1rem; font-size: .84rem; }
  .related-projects { background: var(--white); }
  .faq-grid { display: grid; grid-template-columns: minmax(250px,.75fr) minmax(0,1.25fr); gap: clamp(2rem,6vw,6rem); }
  .faq-grid details { border-top: 1px solid var(--line); padding: 1rem 0; }
  .faq-grid details:last-child { border-bottom: 1px solid var(--line); }
  .faq-grid summary { cursor: pointer; font-family: Georgia,serif; font-size: 1.2rem; font-weight: 600; }
  .faq-grid details p { margin-top: .8rem; color: var(--ink-soft); }
  @media (max-width: 850px) { .detail-grid,.faq-grid { grid-template-columns: 1fr; } .process-section ol { grid-template-columns: 1fr; } .process-section li,.process-section li:first-child { border: 0; border-top: 1px solid var(--line); padding: 1rem 0; } }
  @media (max-width: 600px) { .work-list { grid-template-columns: 1fr; } }
</style>

---
import { getCollection } from "astro:content";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContactBand from "@/components/ContactBand.astro";
import Icon from "@/components/Icon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/urls";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Leistungen | Renovierung & Ausbau München | BauXpert" description="Renovierung, Sanierung, Trockenbau, Maler-, Fliesen-, Boden-, Montage- und Rückbauarbeiten in München.">
  <div class="page-hero"><div class="shell"><p class="eyebrow">Leistungen</p><h1>Handwerksarbeit für Räume, die wieder funktionieren sollen.</h1><p class="lead">Vom einzelnen Montageauftrag bis zu zusammenhängenden Renovierungsarbeiten. Der genaue Umfang wird für jedes Objekt klar abgegrenzt.</p></div></div>
  <Breadcrumbs items={[{ label: "Leistungen" }]} />
  <section class="section">
    <div class="shell services-list">
      {services.map((service, index) => (
        <article>
          <span class="service-number">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h2>{service.data.title}</h2>
            <p>{service.data.intro}</p>
            <ul>{service.data.typicalWork.slice(0, 5).map((item) => <li><Icon name="check" size={17} /> {item}</li>)}</ul>
          </div>
          <a class="text-link" href={withBase(`/leistungen/${service.id}/`)}>Details <Icon name="arrow" size={17} /></a>
        </article>
      ))}
    </div>
  </section>
  <section class="scope-note"><div class="shell"><h2>Wichtig bei Fachgewerken.</h2><p>Zulassungspflichtige Elektro-, Sanitär- oder andere Facharbeiten dürfen nur im Rahmen der tatsächlich vorhandenen Qualifikation beziehungsweise durch entsprechend qualifizierte Fachbetriebe ausgeführt werden. Welche Schnittstellen ein Projekt hat, wird vor Auftrag geklärt.</p></div></section>
  <ContactBand />
</BaseLayout>

<style>
  .services-list { border-top: 1px solid var(--line); }
  .services-list article { display: grid; grid-template-columns: 62px minmax(0,1fr) auto; gap: clamp(1rem,3vw,2.5rem); border-bottom: 1px solid var(--line); padding-block: clamp(2rem,4vw,3.5rem); }
  .service-number { color: var(--clay); font-family: Georgia, serif; font-size: 1.2rem; }
  article h2 { font-size: clamp(1.9rem,3vw,3rem); }
  article h2 + p { max-width: 760px; margin: .85rem 0 1.2rem; color: var(--ink-soft); }
  article ul { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .45rem 1rem; list-style: none; }
  article li { display: flex; gap: .35rem; align-items: flex-start; font-size: .82rem; }
  article .text-link { align-self: center; }
  .scope-note { padding-block: clamp(3.5rem,7vw,6rem); color: white; background: var(--ink); }
  .scope-note .shell { display: grid; grid-template-columns: minmax(240px,.6fr) minmax(0,1.4fr); gap: 3rem; }
  .scope-note p { color: rgba(255,255,255,.72); }
  @media (max-width: 700px) { .services-list article { grid-template-columns: 36px 1fr; } article .text-link { grid-column: 2; } article ul { grid-template-columns: 1fr; } .scope-note .shell { grid-template-columns: 1fr; gap: 1rem; } }
</style>

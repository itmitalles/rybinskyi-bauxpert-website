---
import { getCollection } from "astro:content";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContactBand from "@/components/ContactBand.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Projekte & Referenzen München | Rybinskyi BauXpert" description="Echte Projektfotos von Renovierung, Innenausbau, Boden-, Fliesen- und Montagearbeiten in München und Umgebung.">
  <div class="page-hero"><div class="shell"><p class="eyebrow">Projekte</p><h1>Echte Arbeiten. Ehrlich dokumentiert.</h1><p class="lead">Keine Stockfotos, keine erfundenen Fallstudien. Die vorhandenen Aufnahmen werden nach Projekt zusammengehalten und nur mit belegbaren Angaben beschrieben.</p></div></div>
  <Breadcrumbs items={[{ label: "Projekte" }]} />
  <section class="section"><div class="shell"><SectionHeading eyebrow={`${projects.length} Projektgruppen`} title="Aus München und Umgebung." intro="Bei einigen älteren Referenzen ist derzeit nur ein Abschlussfoto vorhanden. Wo mehrere Perspektiven oder Zwischenstände existieren, zeigen die Projektseiten den Verlauf ausführlicher." /><div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} priority={index < 2} />)}</div></div></section>
  <ContactBand title="Ein ähnliches Projekt geplant?" text="Schicken Sie ein paar Bilder vom aktuellen Zustand und schreiben Sie dazu, was sich ändern soll." />
</BaseLayout>

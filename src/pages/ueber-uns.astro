---
import { siteConfig } from "@/config/site";
import { withBase } from "@/lib/urls";

const target = withBase("/ueber-mich/");
const robots = siteConfig.previewMode ? "noindex,nofollow,noarchive" : "noindex,follow";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />
    <meta name="description" content="Weiterleitung zur Betriebsseite von Rybinskyi BauXpert." />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={`${siteConfig.productionUrl}/ueber-mich/`} />
    <title>Weiterleitung zum Betrieb | Rybinskyi BauXpert</title>
  </head>
  <body>
    <p>Die Seite heißt jetzt <a href={target}>Betrieb</a>.</p>
  </body>
</html>

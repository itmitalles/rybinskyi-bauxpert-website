---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { withBase } from "@/lib/urls";

const adTitle = "Küchenmontage, Möbelmontage & Innenausbau in München";
const adText = `Sie möchten eine Küche montieren, Möbel aufbauen oder einzelne Ausbau- und Renovierungsarbeiten umsetzen?

Rybinskyi BauXpert ist in München und Umgebung für folgende Arbeiten ansprechbar:

• Küchenmontage
• Möbelmontage und geeignete Maßanpassungen
• Innenausbau
• Bodenarbeiten
• Renovierungsarbeiten
• kleinere Montage- und Ausbauprojekte

Der genaue Umfang wird vorab anhand der konkreten Aufgabe abgestimmt. Für eine erste Einordnung helfen:

• Ort oder Stadtteil
• kurze Beschreibung der gewünschten Arbeiten
• Maße, Plan oder Lieferumfang
• Fotos des aktuellen Zustands
• gewünschter Zeitraum

Elektro- und Sanitärfacharbeiten sind kein pauschaler Bestandteil. Es werden nur tatsächlich angebotene und erlaubte Eigenleistungen vereinbart. Falls Facharbeiten erforderlich sind, werden diese getrennt mit geeigneten Fachbetrieben abgestimmt.

Kontakt:
Telefon / WhatsApp: ${siteConfig.phoneDisplay}
E-Mail: ${siteConfig.email}`;

const photos = [
  {
    src: "/preview/customer/kuechenmontage-u-form-fertig.webp",
    alt: "Fertig montierte U-förmige Küche als Kundenprojekt",
    label: "Bild 1 · Küche fertig",
    width: 1200,
    height: 1600,
  },
  {
    src: "/preview/customer/kuechenmontage-u-form-waehrend.webp",
    alt: "U-förmige Küche während der Montage",
    label: "Bild 2 · Küche während der Montage",
    width: 1200,
    height: 1600,
  },
  {
    src: "/preview/customer/hochbett-montage-fertig.webp",
    alt: "Fertig aufgebautes Hochbett mit Stauraum",
    label: "Bild 3 · Möbelmontage",
    width: 1600,
    height: 1200,
  },
  {
    src: "/preview/customer/fischgraet-parkett.webp",
    alt: "Verlegter Boden im Fischgrätmuster",
    label: "Bild 4 · Bodenarbeit",
    width: 503,
    height: 614,
  },
] as const;
---

<BaseLayout
  title="Kleinanzeigen-Paket | Rybinskyi BauXpert Preview"
  description="Kopierfertiger Kleinanzeigen-Text mit ausgewählten Kundenfotos für Rybinskyi BauXpert."
  hideChrome={true}
  showVariantBack={true}
  variantLabel="Пакет для Kleinanzeigen"
>
  <div class="ad-package" data-preview-variant="kleinanzeigen">
    <header class="package-header">
      <a class="package-brand" href={withBase("/")} aria-label="Повернутися до вибору варіанта">
        <img src={withBase("/brand/rybinskyi-bauxpert-logo.webp")} alt="" width="320" height="320" />
        <strong>Rybinskyi BauXpert</strong>
      </a>
      <span>Anzeigenentwurf · nicht veröffentlicht</span>
    </header>

    <main class="package-main">
      <header class="package-intro">
        <p>Kleinanzeigen-Paket</p>
        <h1>Text kopieren, Bilder herunterladen, fertig.</h1>
        <p>Der Vorschlag ist bewusst schlicht gehalten. Titel und Text lassen sich einzeln kopieren. Das gestaltete Titelbild steht zuerst; danach folgen vier echte Projektfotos zum Herunterladen.</p>
      </header>

      <section class="copy-card" aria-labelledby="ad-title-heading">
        <div class="copy-heading">
          <div><span>01</span><h2 id="ad-title-heading">Titel</h2></div>
          <button type="button" data-copy-button="ad-title">Titel kopieren</button>
        </div>
        <textarea id="ad-title" rows="2" aria-labelledby="ad-title-heading" readonly>{adTitle}</textarea>
      </section>

      <section class="copy-card" aria-labelledby="ad-text-heading">
        <div class="copy-heading">
          <div><span>02</span><h2 id="ad-text-heading">Anzeigentext</h2></div>
          <button type="button" data-copy-button="ad-text">Text kopieren</button>
        </div>
        <textarea id="ad-text" rows="25" aria-labelledby="ad-text-heading" readonly>{adText}</textarea>
      </section>

      <section class="photo-section" data-hero-kind="kitchen" aria-labelledby="photo-heading">
        <div class="photo-heading">
          <div><span>03</span><h2 id="photo-heading">Bilder</h2></div>
          <p>Projektfotos aus dem vorhandenen Kundenmaterial. Die finale Auswahl und Bildfreigabe wird mit Denys abgestimmt.</p>
        </div>
        <div class="photo-grid">
          <figure class="photo-cover" data-generated-composite>
            <img src={withBase("/preview/kleinanzeigen/kleinanzeigen-titelbild-ki-v1.webp")} alt="KI-gestaltetes Kleinanzeigen-Titelbild für Küchenmontage, Möbelmontage, Innenausbau und Böden in München" width="1254" height="1254" loading="eager" fetchpriority="high" />
            <figcaption>
              <strong>Titelbild · KI-gestaltete Collage</strong>
              <a href={withBase("/preview/kleinanzeigen/kleinanzeigen-titelbild-ki-v1.webp")} download>Titelbild herunterladen</a>
            </figcaption>
          </figure>
          {photos.map((photo) => (
            <figure data-customer-photo>
              <img src={withBase(photo.src)} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" />
              <figcaption>
                <strong>{photo.label}</strong>
                <a href={withBase(photo.src)} download>Bild herunterladen</a>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <aside class="package-note">
        <strong>Vor Veröffentlichung prüfen:</strong>
        <p>Kontaktdaten, tatsächlicher Leistungsumfang und Bildrechte sind weiterhin Teil der Kundendabstimmung.</p>
      </aside>
    </main>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-button]").forEach((button) => {
    button.addEventListener("click", async () => {
      const target = document.getElementById(button.dataset.copyButton ?? "");
      if (!(target instanceof HTMLTextAreaElement)) return;
      try {
        await navigator.clipboard.writeText(target.value);
      } catch {
        target.select();
        document.execCommand("copy");
        window.getSelection()?.removeAllRanges();
      }
      const original = button.textContent;
      button.textContent = "Kopiert ✓";
      window.setTimeout(() => { button.textContent = original; }, 1800);
    });
  });
</script>

<style>
  .ad-package { min-height: 100dvh; color: #242823; background: #f1f1ee; }
  .package-header, .package-main { width: min(100% - 40px, 1080px); margin-inline: auto; }
  .package-header { display: flex; min-height: 84px; align-items: center; justify-content: space-between; gap: 1rem; border-bottom: 1px solid #d5d8d3; }
  .package-brand { display: flex; align-items: center; gap: .75rem; text-decoration: none; }
  .package-brand img { width: 54px; height: 54px; object-fit: contain; border-radius: 50%; background: #171b18; }
  .package-brand strong { font-size: .9rem; }
  .package-header > span { color: #874520; font-size: .68rem; font-weight: 850; letter-spacing: .09em; text-transform: uppercase; }
  .package-main { display: grid; gap: 1rem; padding-block: clamp(3rem, 7vw, 6rem); }
  .package-intro { display: grid; max-width: 860px; gap: .9rem; margin-bottom: 1.4rem; }
  .package-intro > p:first-child { color: #176b65; font-size: .7rem; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; }
  .package-intro h1 { font-family: Inter, ui-sans-serif, system-ui, sans-serif; font-size: clamp(2.7rem, 6vw, 5.4rem); font-weight: 900; letter-spacing: -.055em; line-height: .95; }
  .package-intro > p:last-child { max-width: 720px; color: #626762; font-size: 1.05rem; }
  .copy-card, .photo-section { border: 1px solid #d5d8d3; padding: clamp(1.2rem, 3vw, 2rem); background: white; }
  .copy-heading, .photo-heading { display: flex; align-items: start; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .copy-heading > div, .photo-heading > div { display: flex; align-items: baseline; gap: .8rem; }
  .copy-heading span, .photo-heading span { color: #a94718; font-size: .72rem; font-weight: 900; }
  .copy-heading h2, .photo-heading h2 { font-family: Inter, ui-sans-serif, system-ui, sans-serif; font-size: clamp(1.5rem, 3vw, 2.1rem); font-weight: 900; }
  .copy-heading button { min-height: 44px; border: 0; padding: .65rem .9rem; color: white; background: #176b65; font-weight: 850; cursor: pointer; }
  .copy-card textarea { width: 100%; border: 1px solid #cbd0ca; padding: 1rem; color: #242823; background: #fafaf8; font-family: Inter, ui-sans-serif, system-ui, sans-serif; font-size: .92rem; line-height: 1.55; resize: vertical; }
  .photo-heading > p { max-width: 560px; color: #626762; font-size: .8rem; }
  .photo-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; }
  .photo-grid figure { min-width: 0; margin: 0; border: 1px solid #d5d8d3; background: #f1f1ee; }
  .photo-grid img { width: 100%; height: clamp(300px, 34vw, 430px); object-fit: cover; }
  .photo-grid .photo-cover { grid-column: 1 / -1; }
  .photo-grid .photo-cover img { height: auto; aspect-ratio: 1; }
  .photo-grid figcaption { display: flex; align-items: center; justify-content: space-between; gap: .8rem; padding: .8rem; font-size: .76rem; }
  .photo-grid figcaption a { color: #176b65; font-weight: 850; }
  .package-note { display: grid; grid-template-columns: minmax(190px, .35fr) 1fr; gap: 1rem; border-left: 5px solid #a94718; padding: 1rem 1.2rem; background: #fff2e9; }
  .package-note p { color: #6d5b50; font-size: .84rem; }
  @media (max-width: 700px) {
    .package-header, .package-main { width: min(100% - 28px, 1080px); }
    .package-header { align-items: flex-start; flex-direction: column; justify-content: center; padding-block: .8rem; }
    .copy-heading, .photo-heading { align-items: stretch; flex-direction: column; }
    .copy-heading button { width: 100%; }
    .photo-grid { grid-template-columns: 1fr; }
    .photo-grid img { height: min(105vw, 430px); }
    .photo-heading > p { max-width: none; }
    .package-note { grid-template-columns: 1fr; }
  }
</style>

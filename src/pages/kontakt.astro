---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Icon from "@/components/Icon.astro";
import InquiryBuilder from "@/components/InquiryBuilder.astro";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { whatsappUrl } from "@/lib/urls";
---
<BaseLayout title="Kontakt & Anfrage | Rybinskyi BauXpert München" description="Rybinskyi BauXpert direkt per Telefon, WhatsApp oder E-Mail erreichen und Renovierungs- oder Sanierungsprojekt in München beschreiben.">
  <div class="page-hero"><div class="shell"><p class="eyebrow">Kontakt</p><h1>Was soll gemacht werden?</h1><p class="lead">Rufen Sie an, schicken Sie Fotos per WhatsApp oder stellen Sie unten eine kurze Projektanfrage zusammen.</p></div></div>
  <Breadcrumbs items={[{ label: "Kontakt" }]} />
  <section class="section contact-section"><div class="shell contact-grid"><div><p class="eyebrow">Direkt erreichbar</p><h2>Einfach Kontakt aufnehmen.</h2><div class="contact-options"><a href={`tel:${siteConfig.phoneHref}`}><Icon name="phone" size={28} /><span><small>Telefon</small><strong>{siteConfig.phoneDisplay}</strong></span></a><a href={whatsappUrl(siteConfig.whatsappText)} target="_blank" rel="noreferrer"><Icon name="whatsapp" size={28} /><span><small>WhatsApp</small><strong>Nachricht & Fotos senden</strong></span></a><a href={`mailto:${siteConfig.email}`}><Icon name="mail" size={28} /><span><small>E-Mail</small><strong>{siteConfig.email}</strong></span></a></div></div><aside><p class="eyebrow">Vorbereitung</p><h3>Damit die erste Einschätzung leichter wird:</h3><ul><li><Icon name="check" size={18} /> Ort oder Stadtteil</li><li><Icon name="check" size={18} /> Fotos vom aktuellen Zustand</li><li><Icon name="check" size={18} /> Gewünschte Arbeiten</li><li><Icon name="check" size={18} /> Ungefährer Umfang</li><li><Icon name="check" size={18} /> Gewünschter Zeitraum</li></ul></aside></div></section>
  <section id="anfrage" class="section builder-section"><div class="shell"><header class="builder-heading"><p class="eyebrow">Anfrage-Builder</p><h2>Projekt in wenigen Punkten beschreiben.</h2><p>Die Angaben bleiben im Browser. Der Builder erzeugt daraus eine WhatsApp-Nachricht oder E-Mail.</p></header><InquiryBuilder /></div></section>
  <section class="section address-section"><div class="shell"><div><p class="eyebrow">Anschrift</p><h2>{siteConfig.name}</h2><p>{siteConfig.owner}<br />{siteConfig.address.street}<br />{siteConfig.address.postalCode} {siteConfig.address.city}</p></div><div><p class="eyebrow">Einsatzgebiet</p><p>München & Umgebung – insbesondere {siteConfig.areas.join(", ")}.</p><p class="privacy-note">Beim Öffnen von WhatsApp verlassen Sie diese Website; dabei gelten die Datenschutzbedingungen von WhatsApp/Meta.</p></div></div></section>
</BaseLayout>
<style>
  .contact-grid { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr); gap:clamp(3rem,8vw,8rem); }
  .contact-options { display:grid; margin-top:2rem; border-top:1px solid var(--line); }
  .contact-options a { display:flex; align-items:center; gap:1rem; border-bottom:1px solid var(--line); padding:1.2rem 0; text-decoration:none; }
  .contact-options a:hover { color:var(--clay-dark); }
  .contact-options span { display:grid; }
  .contact-options small { color:var(--ink-soft); font-size:.7rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .contact-options strong { font-size:1.05rem; }
  .contact-grid aside { height:fit-content; border-top:4px solid var(--clay); padding:1.5rem; background:var(--white); }
  .contact-grid aside h3 { margin-bottom:1.2rem; }
  .contact-grid aside ul { display:grid; gap:.6rem; list-style:none; }
  .contact-grid aside li { display:flex; align-items:center; gap:.45rem; }
  .builder-section { background:var(--paper-deep); scroll-margin-top:calc(var(--header-height) + 1rem); }
  .builder-heading { max-width:760px; margin-bottom:2rem; }
  .builder-heading > p:last-child { margin-top:1rem; color:var(--ink-soft); }
  .address-section { color:white; background:var(--ink); }
  .address-section .shell { display:grid; grid-template-columns:1fr 1fr; gap:4rem; }
  .address-section .eyebrow { color:#dfbd72; }
  .address-section h2 { margin-bottom:1rem; }
  .address-section .shell > div > p:not(.eyebrow) { color:rgba(255,255,255,.7); }
  .privacy-note { margin-top:1.2rem; font-size:.72rem; }
  @media(max-width:750px){ .contact-grid,.address-section .shell { grid-template-columns:1fr; } }
</style>
